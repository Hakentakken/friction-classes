---
import { site, link } from '../config.mjs';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.jpg', { eager: true });
const { preview = false } = Astro.props;
const members = preview ? site.team.slice(0, 3) : site.team;
---
<div class="team-grid">
{members.map((person, i) => {
  const publicPhoto = ['webp', 'jpeg', 'jpg', 'png'].map(ext => `images/people/${person.slug}.${ext}`).find(path => existsSync(resolve('public', path)));
  const photo = publicPhoto ? { src: link(publicPhoto) } : photos[`../assets/team/${person.slug}.jpg`]?.default;
  return <article class="mentor-card reveal" id={person.slug}><div class:list={['portrait', `tone-${i % 3}`, {'has-photo': !!photo}]}>
    {photo ? <img src={photo.src} width="440" height="400" loading="lazy" decoding="async" alt={`${person.name}, ${person.role.toLowerCase()} at Friction Classes`} style={person.slug === 'tamanna' ? 'object-position: 50% 18%; transform: scale(1.5); transform-origin: 50% 20%;' : person.slug === 'vivek' ? 'object-position: 50% 0%;' : 'object-position: 50% 25%;'}/> : <><span class="portrait-lines" aria-hidden="true"></span><span class="monogram" aria-hidden="true">{person.name.charAt(0)}</span><span class="portrait-note">Meet your mentor</span></>}
    <span class="institution">{person.institution}</span>
  </div><div class="mentor-copy"><span class="small-label">{person.role}</span><h3>{person.name}</h3><p class="discipline">{person.discipline}</p><p>{person.bio}</p></div></article>;
})}
{!preview && <article class="mentor-card joining reveal"><span aria-hidden="true">＋</span><h3>More mentors joining</h3><p>We’re growing thoughtfully, with people who care about the learner behind every question.</p></article>}
</div>
<style>.portrait.has-photo { height: 360px; }</style>
