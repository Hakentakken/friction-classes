---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Closing from '../components/Closing.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import TimeZones from '../components/TimeZones.astro';
import NriPillar from '../components/NriPillar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, link, steps } from '../config.mjs';
const pages = {
  about: { title: 'About Friction Classes', label: 'THE IDEA BEHIND FRICTION', heading: 'A little grip changes', emphasis: 'the whole journey.', intro: 'Friction gives a wheel the grip to move forward. We believe a little thoughtful support can do the same for a child’s learning.' },
  programs: { title: 'Programs for Classes 1–9', label: 'GROWING WITH YOUR CHILD', heading: 'Their next chapter.', emphasis: 'Their own pace.', intro: 'One-on-one online learning for Classes 1–9, shaped around where your child is today and the understanding they need next.' },
  subjects: { title: 'Our Subjects', label: 'IDEAS WORTH EXPLORING', heading: 'Beyond memorising.', emphasis: 'Into understanding.', intro: 'From a first fraction to a line of code, we make room to explore, ask again and connect ideas.' },
  mentors: { title: 'Our Mentors', label: 'THE PEOPLE IN THEIR CORNER', heading: 'Curious minds.', emphasis: 'A personal connection.', intro: 'Engineering students and mentors from top institutions such as IIT Madras and NSUT. Here to make learning a conversation.' },
  'how-it-works': { title: 'How It Works', label: 'FROM HELLO TO “I GET IT”', heading: 'A thoughtful start.', emphasis: 'A clear way forward.', intro: 'You don’t need to have it all figured out. Tell us about your child, and we’ll work through the next steps together.' },
  'nri-families': { title: 'For NRI Families', label: 'LEARNING WITHOUT THE DISTANCE', heading: 'Online tuition for', emphasis: 'NRI students.', intro: 'Personalized online tuition for NRI families and students in any country. Your child’s schoolwork, your family’s routine, our shared attention.' },
  faq: { title: 'Frequently Asked Questions', label: 'QUESTIONS ARE A GOOD BEGINNING', heading: 'A little clarity.', emphasis: 'A little peace of mind.', intro: 'The practical details, and the things you might be wondering about before getting in touch.' },
  contact: { title: 'Contact & Book a Demo Class', label: 'LET’S START WITH YOUR CHILD', heading: 'Tell us what’s', emphasis: 'on your mind.', intro: 'A tricky subject, a quiet worry, a new school curriculum. You can start wherever you are.' },
  privacy: { title: 'Privacy', label: 'YOUR INFORMATION', heading: 'Simple by design.', emphasis: 'Thoughtful with data.', intro: 'Here is what happens when you browse this website or choose to contact Friction Classes.' },
  terms: { title: 'Terms', label: 'CLEAR EXPECTATIONS', heading: 'A shared', emphasis: 'understanding.', intro: 'These terms explain the purpose of this website and how to take the next step with Friction Classes.' },
};
export function getStaticPaths() { return ['about','programs','subjects','mentors','how-it-works','nri-families','faq','contact','privacy','terms'].map(page => ({ params: { page } })); }
const page = Astro.params.page as keyof typeof pages;
const meta = pages[page];
---
<Layout title={meta.title} description={meta.intro}>
<section class="page-hero wrap"><Breadcrumbs/><p class="eyebrow">{meta.label}</p><h1>{meta.heading}<br/><em>{meta.emphasis}</em></h1><p>{meta.intro}</p><span class="page-spark" aria-hidden="true">✳</span></section>
{page === 'about' && <><section class="section wrap story-grid"><div class="manifesto"><span aria-hidden="true">◎</span><h2>One child.<br/>One mentor.<br/><em>Room to become.</em></h2><p>{site.tagline}</p></div><div class="prose"><p class="eyebrow">A NEW BEGINNING</p><h2>Built around the learner.</h2><p>Friction Classes is a new learning initiative founded by Vivek, an Instrumentation Engineering student at NSUT. The idea is simple: give each child the attention to understand, rather than just keep up.</p><p>We offer personalized one-on-one online tuition for Classes 1–9. Our team brings together engineering students and mentors, with a focus on clear explanations, patient practice and a personal connection.</p><p>We want children to feel comfortable saying “I don’t understand yet.” That little word, yet, leaves room for learning.</p><a class="text-link" href={link('mentors/')}>Get to know our mentors ↗</a></div></section><section class="section wrap"><div class="section-heading"><h2>What we make<br/><em>room for.</em></h2></div><div class="values-grid"><article><span>01 / UNDERSTANDING</span><h3>The reason behind the answer.</h3><p>We help your child explore the why, connect the steps and explain what they’re thinking.</p></article><article><span>02 / CONFIDENCE</span><h3>Progress that feels personal.</h3><p>Learning includes trying again, asking for help and becoming more comfortable with a challenge.</p></article><article><span>03 / PARTNERSHIP</span><h3>Parents in the conversation.</h3><p>Your observations matter. Regular updates and shared next steps help us support your child together.</p></article></div></section></>}
{page === 'programs' && <section class="wrap section content-stack">{site.gradeBands.map((band, i) => <article class="program-detail reveal" id={`band-${i}`}><div class="program-label"><span>{band.label}</span><span class="large-number" aria-hidden="true">0{i + 1}</span></div><div><p class="eyebrow">{band.focus}</p><h2>{band.title}</h2><p>{band.description}</p><p>{band.details}</p><a class="text-link" href={link(`programs/classes-${['1-3','4-6','7-9'][i]}/`)}>Explore the {band.label} learning guide <span aria-hidden="true">↗</span></a><p class="muted">Subject choices: {site.subjects.map(s => s.name).join(' · ')}</p><Button/></div></article>)}<aside class="notice"><h3>Your schoolwork is the starting point.</h3><p>Lessons are aligned to your child’s curriculum: {site.curricula.join(', ')}. Share the current topics and school expectations so we can discuss the right support. Class levels and school systems vary; we confirm the fit together.</p><p>Message us for a personalized plan.</p></aside></section>}
{page === 'subjects' && <section class="section wrap content-stack">{site.subjects.map((subject, i) => <article class="subject-detail reveal" id={`subject-${i}`}><span class="big-symbol" aria-hidden="true">{subject.symbol}</span><div><p class="eyebrow">{subject.line}</p><h2>{subject.name}</h2><p>{subject.description}</p><ul class="topic-list">{subject.topics.map(topic => <li>{topic}</li>)}</ul><p class="muted">Activities and depth are adapted to your child’s class and current understanding.</p><Button/></div></article>)}<aside class="notice"><h3>Connected to what they’re learning at school.</h3><p>Aligned to your child’s curriculum, including {site.curricula.join(', ')}. Share their syllabus so we can discuss topic coverage and mentor availability.</p></aside></section>}
{page === 'mentors' && <section class="section wrap"><h2>Meet the people behind the lessons.</h2><Team/><aside class="notice"><h2>A thoughtful match matters.</h2><p>We discuss your child’s subject, learning needs and schedule before confirming a mentor. The institutions listed describe our team members’ study backgrounds; they do not imply institutional endorsement or affiliation.</p></aside></section>}
{page === 'how-it-works' && <section class="section wrap process-layout"><ol class="process-list">{steps.map((step, i) => <li class="reveal"><span class="step-number">0{i + 1}</span><div><h2>{step.title}</h2><p>{step.text}</p>{i === 0 && <p>You can message us directly or use the contact form to prepare a WhatsApp message. No long application needed.</p>}{i === 1 && <p>Share school topics, strengths and the places where your child loses confidence. We confirm the demo details with you before it takes place.</p>}{i === 2 && <p>We agree on subject coverage, class arrangements and the plan’s terms before regular lessons begin.</p>}{i === 3 && <p>As learning develops, we discuss what is becoming clearer and what still needs practice. Your feedback helps shape the next steps.</p>}</div></li>)}</ol><aside class="notice process-aside"><p class="eyebrow">BEFORE WE CHAT</p><h3>A few helpful details</h3><ul class="topic-list"><li>Your child’s class and curriculum</li><li>Subjects they would like help with</li><li>Your city and preferred times</li><li>Anything you’d like us to understand</li></ul><Button/><p class="small-note">We’ll confirm timing and availability together.</p></aside></section>}
{page === 'nri-families' && <><section class="section wrap nri-grid"><div><p class="eyebrow">A ROUTINE THAT FITS REAL LIFE</p><h2>Different clocks.<br/><em>The same care.</em></h2><p>Whether your family is in the USA, UK, UAE, Canada, Australia, Singapore or elsewhere, tell us when your child has room to learn.</p><p>We discuss available slots across time zones and confirm the city and local time together. When clocks change for daylight saving, we revisit the schedule with you.</p><Button/></div><TimeZones/></section><section class="section wrap values-grid"><article><span>YOUR CURRICULUM</span><h3>School comes with context.</h3><p>Share the syllabus, topic list or school feedback. Lessons are aligned to your child’s curriculum, including {site.curricula.join(', ')}.</p></article><article><span>YOUR FAMILY</span><h3>Stay close to the learning.</h3><p>Regular parent updates help you understand what is being practised and where your child needs encouragement.</p></article><article><span>YOUR STARTING POINT</span><h3>A move can change a lot.</h3><p>New expectations or unfamiliar topics can feel big. We discuss what your child needs now and take the next step at their pace.</p></article></section></>}
{page === 'nri-families' && <NriPillar/>}
{page === 'faq' && <section class="section wrap narrow"><Faq/><p class="faq-followup">Still something on your mind? <a class="text-link" href={link('contact/')}>Let’s talk ↗</a></p></section>}
{page === 'contact' && <section class="section wrap contact-grid"><div><p class="eyebrow">A CONVERSATION IS A GOOD START</p><h2>Let’s find<br/><em>the right fit.</em></h2><p>Message us for a personalized plan.</p><Button/><a class="contact-phone" href={`tel:+${site.whatsapp}`}>Or call {site.phone} ↗</a>{site.EMAIL && <a href={`mailto:${site.EMAIL}`}>{site.EMAIL}</a>}<div class="contact-note"><span aria-hidden="true">✳</span><p>Send just the details you’re comfortable sharing. Please don’t include school records or sensitive information in this form.</p></div></div><form id="contact-form" class="contact-form" data-whatsapp={site.whatsapp}><h3>A little about your learner</h3><p class="form-intro">This form prepares a message. WhatsApp will open so you can review it and choose to send.</p><div class="field"><label for="parent-name">Parent or guardian’s name</label><input id="parent-name" name="parentName" autocomplete="name" required maxlength="80" placeholder="Your name"/></div><div class="form-row"><div class="field"><label for="child-class">Child’s class</label><select id="child-class" name="childClass" required><option value="">Choose a class</option>{Array.from({length: 9}, (_, i) => <option>Class {i + 1}</option>)}</select></div><div class="field"><label for="subject">Subject</label><select id="subject" name="subject" required><option value="">Choose a subject</option>{site.subjects.map(s => <option>{s.name}</option>)}<option>Help me choose</option></select></div></div><div class="field"><label for="country">Country and city</label><input id="country" name="country" autocomplete="country-name" required maxlength="100" placeholder="e.g. UK, London"/></div><div class="field"><label for="preferred-time">Preferred time, in your local time zone</label><input id="preferred-time" name="preferredTime" required maxlength="150" placeholder="e.g. Weekdays after 5 pm, London time"/></div><p class="small-note">All fields are required. This website does not store or submit your form data to a server. The prepared message is shared with WhatsApp when you continue. <a href={link('privacy/')}>Privacy details</a>.</p><button class="button" type="submit">Book a Demo Class <span aria-hidden="true">↗</span></button><p class="small-note">Opens WhatsApp in a new tab. Nothing is sent automatically.</p><p id="form-status" role="status" aria-live="polite"></p><a id="whatsapp-fallback" class="text-link" target="_blank" rel="noopener noreferrer" hidden>Open your prepared WhatsApp message ↗</a><noscript><p>The form needs JavaScript to prepare your message. Please use the direct WhatsApp button or phone number instead.</p></noscript></form></section>}
{page === 'privacy' && <section class="section wrap legal prose"><h2>Browsing this website</h2><p>This is a static website. We do not run analytics, advertising trackers, accounts or a database. Your browser downloads the pages and self-hosted fonts from the website host. The hosting provider may process technical request information, such as an IP address, to deliver and secure the site.</p><h2>Your theme preference</h2><p>If you choose day or night mode, the site saves that choice in your browser’s local storage under “friction-theme”. It is not sent to us. You can remove it by clearing this website’s browser data.</p><h2>The contact form and WhatsApp</h2><p>The form fields stay in the current page until you choose to open WhatsApp. The website does not save them to local storage, a database or a form service. Submitting the form places those details in a WhatsApp URL and opens WhatsApp so you can review and send the message. That URL may appear in your browser history and is received by WhatsApp when opened.</p><p>WhatsApp handles information under its own policies. Once you send a message, we receive the information in that conversation so we can respond and discuss learning arrangements. Do not share sensitive information in the form.</p><h2>Children’s information</h2><p>The contact form is intended for a parent or guardian. We ask for a class level, not the child’s name, date of birth or school records. A parent or guardian should handle initial enquiries and class arrangements.</p><h2>Questions or requests</h2><p>Contact us on WhatsApp or by phone at <a href={`tel:+${site.whatsapp}`}>{site.phone}</a> to ask about information you have shared with us, or to request its correction or deletion. We will discuss your request and any information that needs to be retained for ongoing arrangements.</p></section>}
{page === 'terms' && <section class="section wrap legal prose"><h2>About this website</h2><p>Friction Classes provides information here about personalized one-on-one online tuition for Classes 1–9. Browsing the site or making an enquiry does not enrol a child or create a confirmed class booking.</p><h2>Demos and learning plans</h2><p>“Book a Demo Class” opens a WhatsApp enquiry. We confirm the mentor, timing, format and any applicable terms directly with a parent or guardian. A demo is not described as free. Message us for a personalized plan.</p><h2>Before classes begin</h2><p>Subject coverage, availability, payment arrangements, rescheduling, cancellations and any refund terms must be discussed and agreed before regular classes begin. Specific times and mentors depend on availability.</p><h2>Learning and curriculum</h2><p>Lessons are aligned to your child’s curriculum and needs, based on what you share with us. We do not claim affiliation with curriculum boards or the institutions where our mentors study. We do not guarantee marks, examination outcomes or a particular pace of progress.</p><h2>Parent or guardian involvement</h2><p>A parent or guardian should make arrangements for a minor, provide accurate scheduling information and help establish a suitable online learning environment. Respectful communication is expected from everyone.</p><h2>Third-party services</h2><p>Contact links may open WhatsApp or your device’s phone app. Those services operate independently and have their own terms. The website itself does not process payments.</p><h2>Questions</h2><p>Please <a href={link('contact/')}>contact Friction Classes</a> if you want to clarify anything before making arrangements.</p></section>}
{!['privacy','terms','contact'].includes(page) && <Closing/>}
</Layout>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit', event => {
  event.preventDefault();
  const inputs = form.querySelectorAll<HTMLInputElement>('input');
  inputs.forEach(input => input.setCustomValidity(input.value.trim() ? '' : 'Please enter this detail.'));
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const value = (name: string) => String(data.get(name) || '').trim();
  const message = `Hi Friction Classes, I'd like to book a demo class.\nParent/guardian: ${value('parentName')}\nChild's class: ${value('childClass')}\nSubject: ${value('subject')}\nCountry and city: ${value('country')}\nPreferred local time: ${value('preferredTime')}`;
  const url = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`;
  const fallback = document.querySelector<HTMLAnchorElement>('#whatsapp-fallback')!;
  fallback.href = url; fallback.hidden = false;
  document.querySelector('#form-status')!.textContent = 'Your message is ready. If WhatsApp did not open, use the link below. Review your message there before sending.';
  window.open(url, '_blank', 'noopener,noreferrer');
});
form?.querySelectorAll('input').forEach(input => input.addEventListener('input', () => input.setCustomValidity('')));
</script>
