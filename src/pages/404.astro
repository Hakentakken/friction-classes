---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { link } from '../config.mjs';
---
<Layout title="Page not found"><section class="wrap error-page"><p class="eyebrow">404 / A LITTLE DETOUR</p><span class="error-wheel" aria-hidden="true">◎</span><h1>Let’s get back<br/><em>on track.</em></h1><p>This page may have moved, or the link might have a typo.<br/>There’s still plenty to discover.</p><Button href={link()} label="Back to home"/><a class="text-link" href={link('contact/')}>Get in touch ↗</a></section></Layout>
